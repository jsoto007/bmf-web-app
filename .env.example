# Contact form delivery. Configure ONE of the two options below in production.
# Without either, the API route logs submissions in development and returns an
# error in production (the form then shows the phone number as a fallback).

# Option A: forward each submission as JSON to a webhook (Zapier, Make, a CRM, …)
CONTACT_WEBHOOK_URL=

# Option B: email each submission through Resend (https://resend.com)
RESEND_API_KEY=
CONTACT_TO_EMAIL=office@example.com
CONTACT_FROM_EMAIL=Burdier Website <website@example.com>

# Optional: Google Search Console verification token (emits the meta tag).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
